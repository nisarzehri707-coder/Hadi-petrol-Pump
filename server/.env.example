# Hadi Petrol Pump Management System - Server Environment Configuration

# Server Port
PORT=3001
NODE_ENV=development

# PostgreSQL Connection String (format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hadi_petrol_db

# JWT Secrets for Access & Refresh Tokens (Use strong 64-char random string in production)
JWT_SECRET=super_secret_hadi_petrol_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=super_secret_hadi_petrol_jwt_refresh_key_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend Client
CORS_ORIGIN=http://localhost:5173

# Bcrypt Hash Rounds
BCRYPT_ROUNDS=10

# Station Initial Setup Credentials (Used only on initial seeding)
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PIN=7860
INITIAL_CASHIER_USERNAME=cashier
INITIAL_CASHIER_PIN=1234
